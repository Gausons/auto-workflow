{
  "name": "auto-bug-workflow-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx --import ./src/issueSources/preload.ts server.mjs",
    "dev": "node --import tsx --import ./src/issueSources/preload.ts --watch server.mjs",
    "kill:port": "node scripts/kill-port.mjs",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts",
    "tenant": "node --import tsx --import ./src/issueSources/preload.ts scripts/tenant.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
