{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "public",
    "outDir": "public/build",
    "noEmit": false
  },
  "include": ["public/**/*.ts"],
  "exclude": ["public/build"]
}
