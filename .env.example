# 公开版本默认使用 Jira Cloud。修改配置后重启。
ISSUE_PROVIDER=jira
# Jira Cloud：只有 ISSUE_PROVIDER=jira 时使用以下配置。
JIRA_BASE_URL=https://your-team.atlassian.net
# 可选：OAuth 网关地址与站点不同的时候填写实际站点，用于问题链接。
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# 可选：已获取的 OAuth access token；设置后优先使用 Bearer 认证。
JIRA_ACCESS_TOKEN=
# 只填筛选条件，排序由适配器统一添加；支持所有 Jira 问题类型。
JIRA_JQL=project = DEMO
JIRA_PAGE_SIZE=100
JIRA_MAX_PAGES=50
JIRA_TIMEOUT_MS=30000
# 可选 JSON，如 {"Critical":"P0","Normal":"P2"}
JIRA_PRIORITY_MAP={}

# 开发、生产和测试统一使用 PostgreSQL + pgvector。
DATABASE_DRIVER=postgres
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=auto_workflow
PGUSER=auto_workflow
PGPASSWORD=
# 可选：Google 单点登录。回调地址必须与 Google Cloud 控制台中的授权重定向 URI 完全一致。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
# Agent 执行优先使用 ACP v1；设为 false 才禁用并直接使用原 CLI/App Server。
ACP_ENABLED=true
# 默认从 PATH 查找 codex-acp / claude-agent-acp；可填写绝对路径覆盖。
ACP_CODEX_EXECUTABLE=
ACP_CODEX_ARGS=[]
ACP_CLAUDE_EXECUTABLE=
ACP_CLAUDE_ARGS=[]
CODEX_WORKSPACE_DIR=/srv/bugflow/repos/my-project
# 任务中心会探测这些 ACP Agent；Codex 和 Claude Code 默认已包含。
# ACP_AGENTS=codex,claude,my-agent
ENABLE_AI_ASSIGNMENT=true
ENABLE_AUTO_ASSIGNMENT=false
AI_ASSIGNMENT_MODEL=gpt-6-luna
# 有 API Key 时默认启用会话交接模型摘要；可设为 false，只保留规则摘取。
# ENABLE_CONTEXT_SUMMARY=true
# CONTEXT_SUMMARY_MODEL=gpt-6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000
PORT=4173

# Agent 历史会话，只读本地 JSONL，默认显示数据源中的全部工作区。
# 留空时自动读取 CODEX_HOME/sessions、archived_sessions 和 ~/.claude/projects。
IDE_HISTORY_CODEX_DIR=
IDE_HISTORY_CLAUDE_DIR=

# all：全部工作区；workspace：仅 CODEX_WORKSPACE_DIR 及子目录。
IDE_HISTORY_SCOPE=all

# 可选：Codex 可执行文件；macOS 留空时优先使用 Codex / ChatGPT 应用内置版本，再查找 PATH。
CODEX_EXECUTABLE=
# 设备连接器：以下配置复制到独立的 .env.device，运行 pnpm device:connect。
# WORKBENCH_URL=https://workbench.example.com
# WORKBENCH_USERNAME=developer
# WORKBENCH_PASSWORD=
# WORKBENCH_DEVICE_NAME=开发机
# WORKBENCH_DEVICE_DIR=.workflow-data/device
# WORKBENCH_EXECUTE_CODEX=true
# WORKBENCH_SYNC_EXCERPTS=false
# CODEX_WORKSPACE_DIR=/absolute/path/to/repository
# IDE_HISTORY_SCOPE=workspace
