# 每个组织选择一个问题数据源，未设置时兼容内部 PM。修改后重启。
ISSUE_PROVIDER=pm
# Jira Cloud：只有 ISSUE_PROVIDER=jira 时使用以下配置。
JIRA_BASE_URL=https://your-team.atlassian.net
# 可选：OAuth 网关地址与站点不同的时候填写实际站点，用于问题链接。
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# 可选：已获取的 OAuth access token；设置后优先使用 Bearer 认证。
JIRA_ACCESS_TOKEN=
# 只填筛选条件，排序由适配器统一添加；支持所有 Jira 问题类型。
JIRA_JQL=project = DEMO
JIRA_PAGE_SIZE=100
JIRA_MAX_PAGES=50
JIRA_TIMEOUT_MS=30000
# 可选 JSON，如 {"Critical":"P0","Normal":"P2"}
JIRA_PRIORITY_MAP={}

# 以下为内部 PM 数据源的配置。
# SQLite 文件路径（相对项目目录）；需要 Node.js >= 22.16
DATABASE_PATH=.workflow-data/workflow.sqlite
# 各租户独立的 <tenant-id>.env 所在目录
TENANT_ENV_DIR=.workflow-data/tenants
# 组织初始化令牌：仅用于创建首位所有者；至少 32 个字符，留空自动生成到数据库目录/default-token
DEFAULT_TENANT_TOKEN=
PM_BASE_URL=https://pm.example.com
PM_ACCESS_KEY=
PM_ACCESS_TOKEN=
PM_ACCESS_SECRET=
PM_LINE_ID=
PM_FILTER_ID=
PM_ASSIGNEE=
PM_OPERATOR_ID=
PM_SELF_ONLY=false
PM_MAX_PAGES=10
PM_PAGE_SIZE=300
PM_REQUEST_DELAY_MS=1200
PM_RATE_LIMIT_RETRY_MS=5200
IDE_EXECUTOR=codex
CODEX_WORKSPACE_DIR=/srv/bugflow/repos/my-project
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
CLAUDE_MODEL=claude-opus-4-8
CODEX_BASE_BRANCH=main
CODEX_REVIEW_MAX_ROUNDS=3
ENABLE_BUG_INFO_COMPLETION=true
ALLOW_SKIP_INFO_COMPLETION=true
ENABLE_AI_ROUTING=true
ENABLE_AI_ASSIGNMENT=true
ENABLE_AUTO_ASSIGNMENT=false
AI_ASSIGNMENT_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_ROUTING_MODEL=gpt-5.6-sol
AI_ROUTING_TIMEOUT_MS=30000
ALLOWED_AUTO_FIX_PRIORITIES=P2,P3
REQUIRE_VERIFICATION_REPORT=true
REQUIRE_REGRESSION_TEST=false
REQUIRE_HUMAN_REVIEW=true
ENABLE_OPERATION_LOG_UPLOAD=false
OPERATION_LOG_BASE_URL=https://logs.example.com
OPERATION_LOG_ENDPOINT=/apiregister/conversation/logs/batch
OPERATION_LOG_COOKIE=
OPERATION_LOG_TOKEN=
OPERATION_LOG_CHAT_SOURCE=yonclaw_cloud
OPERATION_LOG_SOURCE_TYPE=builtin
OPERATION_LOG_SESSION_ID=
OPERATION_LOG_USER_ID=
OPERATION_LOG_CREATE_NAME=
OPERATION_LOG_DIGITAL_CODE=auto_bug_workflow
OPERATION_LOG_AGENT_NAME=Auto Bug Workflow
OPERATION_LOG_AGENT_VERSION=0.1.0
PORT=4173

# Agent 历史会话，只读本地 JSONL，默认显示数据源中的全部工作区。
# 默认组织留空时自动读取 CODEX_HOME/sessions、archived_sessions 和 ~/.claude/projects。
# 其他组织必须在各自 <tenant-id>.env 中显式设置，路径相对项目根目录。
IDE_HISTORY_CODEX_DIR=
IDE_HISTORY_CLAUDE_DIR=

# all：全部工作区；workspace：仅 CODEX_WORKSPACE_DIR 及子目录。
IDE_HISTORY_SCOPE=all
